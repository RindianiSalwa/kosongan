<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:focusableInTouchMode="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/red_coral">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="52dp"
                    android:paddingBottom="32dp"
                    android:paddingHorizontal="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DAPUR ANDIA"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:letterSpacing="0.18"
                        android:fontFamily="@font/montserrat_bold"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:background="@drawable/bg_badge_white"
                        android:layout_marginBottom="20dp"/>

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/lottieCheckout"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        app:lottie_rawRes="@raw/checkout"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        android:background="@drawable/bg_lottie_white_ring"
                        android:layout_marginBottom="18dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Konfirmasi Pesanan"
                        android:fontFamily="serif"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:layout_marginBottom="14dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:id="@+id/textNama"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="10sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/chip_green_text"
                            android:background="@drawable/bg_chip_green"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:layout_marginEnd="8dp"/>

                        <TextView
                            android:id="@+id/textNoHp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textSize="10sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/chip_blue_text"
                            android:background="@drawable/bg_chip_blue"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/backButtonCheckout"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_back"
                    android:background="@drawable/bg_back_button_white"
                    android:contentDescription="Back"
                    android:layout_margin="16dp"
                    android:padding="8dp"
                    android:layout_gravity="top|start"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_white"
                android:paddingHorizontal="22dp"
                android:paddingTop="24dp"
                android:paddingBottom="160dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALAMAT PENGIRIMAN"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/text_muted"
                    android:layout_marginBottom="10dp"/>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAlamat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/textAlamat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mendeteksi lokasi..."
                            android:textColor="@color/text_dark"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginBottom="4dp"/>

                        <TextView
                            android:id="@+id/textAlamatDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Detail: -"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="12dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGantiAlamat"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Ganti Alamat"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/red_coral"
                            android:backgroundTint="@android:color/transparent"
                            app:cornerRadius="18dp"
                            app:strokeColor="@color/red_coral"
                            app:strokeWidth="1.5dp"
                            app:icon="@drawable/ic_pin_location"
                            app:iconPadding="6dp"
                            app:iconGravity="textStart"
                            app:iconTint="@color/red_coral"
                            android:elevation="0dp"
                            android:stateListAnimator="@null"
                            android:layout_marginBottom="12dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#F0F0F0"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="JARAK"
                                    android:textSize="9sp"
                                    android:letterSpacing="0.1"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:textColor="@color/text_muted"
                                    android:layout_marginBottom="2dp"/>

                                <TextView
                                    android:id="@+id/textJarak"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="- km"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:textColor="@color/text_dark"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ONGKIR"
                                    android:textSize="9sp"
                                    android:letterSpacing="0.1"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:textColor="@color/text_muted"
                                    android:layout_marginBottom="2dp"/>

                                <TextView
                                    android:id="@+id/textOngkir"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Rp 0"
                                    android:textSize="14sp"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:textColor="@color/red_coral"/>
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:hint="Catatan (Opsional)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/red_coral"
                            app:boxStrokeWidth="1.5dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxBackgroundColor="@color/field_bg"
                            app:hintTextColor="@color/text_muted">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editCatatan"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minLines="2"
                                android:maxLines="4"
                                android:textSize="13sp"
                                android:textColor="@color/text_dark"
                                android:paddingVertical="12dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PESANAN ANDA"
                    android:textSize="10sp"
                    android:letterSpacing="0.12"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/text_muted"
                    android:layout_marginBottom="10dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerMenuDipesan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="METODE PEMBAYARAN"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="8dp"/>

            <RadioGroup
                android:id="@+id/radioGroupMetode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <RadioButton
                    android:id="@+id/radioCod"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="COD"
                    android:checked="true"
                    android:fontFamily="@font/montserrat_bold"
                    android:textSize="13sp"
                    android:buttonTint="@color/red_coral"
                    android:textColor="@color/text_dark"/>

                <RadioButton
                    android:id="@+id/radioQris"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="QRIS"
                    android:fontFamily="@font/montserrat_bold"
                    android:textSize="13sp"
                    android:buttonTint="@color/red_coral"
                    android:textColor="@color/text_dark"/>
            </RadioGroup>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/textTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total: Rp 0"
                android:textColor="@color/red_coral"
                android:textSize="18sp"
                android:fontFamily="@font/montserrat_bold"
                android:layout_marginBottom="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonKonfirmasi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Konfirmasi Pesanan"
                android:textAllCaps="false"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                android:backgroundTint="@color/red_coral"
                app:icon="@drawable/ic_login_arrow"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"/>

            <TextView
                android:id="@+id/textMetodeBayar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>