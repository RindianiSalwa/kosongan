<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_page"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/red_coral">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="52dp"
                android:paddingBottom="32dp"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DAPUR ANDIA"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.18"
                    android:fontFamily="@font/montserrat_bold"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="5dp"
                    android:background="@drawable/bg_badge_white"
                    android:layout_marginBottom="20dp"/>

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottiePayment"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    app:lottie_rawRes="@raw/qris"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    android:background="@drawable/bg_lottie_white_ring"
                    android:layout_marginBottom="18dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pembayaran QRIS"
                    android:fontFamily="serif"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/textTotalPayment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 0"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:fontFamily="@font/montserrat_bold"
                    android:layout_marginBottom="14dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aman"
                        android:textSize="10sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/chip_green_text"
                        android:background="@drawable/bg_chip_green"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terverifikasi"
                        android:textSize="10sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/chip_blue_text"
                        android:background="@drawable/bg_chip_blue"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QRIS"
                        android:textSize="10sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/chip_orange_text"
                        android:background="@drawable/bg_chip_orange"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/backButtonPayment"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/bg_back_button_white"
                android:contentDescription="Back"
                android:layout_margin="16dp"
                android:padding="8dp"
                android:layout_gravity="top|start"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_white"
            android:paddingHorizontal="22dp"
            android:paddingTop="24dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCAN QR CODE"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="14dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="20dp">

                    <FrameLayout
                        android:layout_width="240dp"
                        android:layout_height="240dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/imageQris"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp"
                            android:scaleType="fitCenter"/>

                        <ProgressBar
                            android:id="@+id/progressQris"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/red_coral"
                            android:visibility="visible"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_chip_green"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_timer"
                            app:tint="@color/chip_green_text"
                            android:layout_marginEnd="6dp"/>

                        <TextView
                            android:id="@+id/textTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Berlaku: 15:00"
                            android:textSize="12sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/chip_green_text"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textInvoiceId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Invoice: -"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CARA PEMBAYARAN"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="10dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="1"
                            android:textSize="11sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:background="@color/red_coral"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Buka aplikasi GoPay / m-Banking"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="2"
                            android:textSize="11sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:background="@color/red_coral"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pilih menu Scan QR"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="3"
                            android:textSize="11sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:background="@color/red_coral"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scan QR code di atas"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="4"
                            android:textSize="11sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:background="@color/red_coral"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Selesaikan pembayaran"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="5"
                            android:textSize="11sp"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:background="@color/red_coral"
                            android:layout_marginEnd="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Klik tombol 'Sudah Bayar' di bawah"
                            android:textSize="13sp"
                            android:textColor="@color/text_dark"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSudahBayar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Sudah Bayar"
                android:textAllCaps="false"
                android:fontFamily="@font/montserrat_bold"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/red_coral"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_check"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonBatalPayment"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Batalkan Pembayaran"
                android:textAllCaps="false"
                android:fontFamily="@font/montserrat_bold"
                android:textSize="14sp"
                android:textColor="@color/red_coral"
                android:backgroundTint="@android:color/transparent"
                app:strokeColor="@color/red_coral"
                app:strokeWidth="1.5dp"
                app:cornerRadius="14dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
