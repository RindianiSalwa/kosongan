<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="20dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp"
        android:background="#CCCCCC" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pilih Alamat"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Tentukan Lokasi di Peta -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPinMap"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Tentukan Lokasi di Peta"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="@font/nunito_bold"
        android:textColor="@color/maroon_700"
        android:backgroundTint="@android:color/white"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_map"
        app:iconPadding="8dp"
        app:iconSize="20dp"
        app:iconGravity="textStart"
        android:paddingHorizontal="16dp"
        app:iconTint="@null"
        app:rippleColor="@color/maroon_200"
        app:strokeWidth="1dp"
        app:strokeColor="@color/maroon_700" />

    <!-- Lokasi saat ini -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLokasiSaatIni"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="Lokasimu saat ini"
        android:textAllCaps="false"
        app:iconSize="20dp"
        app:iconGravity="textStart"
        android:paddingHorizontal="16dp"
        android:textSize="14sp"
        android:fontFamily="@font/nunito_bold"
        android:textColor="@color/maroon_700"
        android:backgroundTint="@android:color/white"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_pin_location"
        app:iconPadding="8dp"
        app:iconTint="@null"
        app:rippleColor="@color/maroon_200"
        app:strokeWidth="1dp"
        app:strokeColor="@color/maroon_700" />

</LinearLayout>
