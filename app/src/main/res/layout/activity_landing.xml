<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".LandingActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@color/red_coral"
            android:paddingTop="52dp"
            android:paddingBottom="40dp"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAPUR ANDIA"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:letterSpacing="0.18"
                android:fontFamily="@font/montserrat_bold"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_badge_white"
                android:layout_marginBottom="20dp" />

            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieView"
                android:layout_width="110dp"
                android:layout_height="110dp"
                app:lottie_rawRes="@raw/landingg"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                android:background="@drawable/bg_lottie_white_ring"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/txtSlogan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dari Dapur Andia,\nuntuk Perut Bahagia"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:gravity="center"
                android:textAlignment="center"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Segar"
                    android:textSize="10sp"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/chip_green_text"
                    android:background="@drawable/bg_chip_green"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Higienis"
                    android:textSize="10sp"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/chip_blue_text"
                    android:background="@drawable/bg_chip_blue"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lezat"
                    android:textSize="10sp"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/chip_orange_text"
                    android:background="@drawable/bg_chip_orange"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_white"
            android:paddingHorizontal="22dp"
            android:paddingTop="28dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MASUK SEBAGAI"
                android:textSize="10sp"
                android:letterSpacing="0.12"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="10dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxStrokeColor="@color/indigo_400"
                app:boxStrokeWidth="1.5dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxBackgroundColor="@color/field_bg"
                app:hintTextColor="@color/text_muted"
                app:endIconTint="@color/text_muted"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="@color/orange_icon">

                <AutoCompleteTextView
                    android:id="@+id/actRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Pilih Peran"
                    android:inputType="none"
                    android:textSize="14sp"
                    android:textColor="@color/text_dark"
                    android:paddingVertical="14dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Masuk"
                android:textAllCaps="false"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                android:backgroundTint="@color/red_coral"
                app:icon="@drawable/ic_login_arrow"
                app:iconTint="#FFFFFF"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:layout_marginBottom="18dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider_color" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="atau"
                    android:textSize="11sp"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/text_muted"
                    android:paddingHorizontal="12dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/divider_color" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Belum punya akun? Daftar sebagai pembeli"
                android:textSize="12sp"
                android:textColor="@color/text_muted"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>