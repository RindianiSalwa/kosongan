<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- AppBar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarEditMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/maroon_700"
        android:title="Edit Menu"
        android:fontFamily="@font/quicksand_bold"
        android:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Gambar Menu + Icon Edit -->
            <FrameLayout
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginBottom="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivMenu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_default_menu"/>

                <ImageView
                    android:id="@+id/btnEditPhoto"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="6dp"
                    android:src="@drawable/ic_edit_photo"
                    android:background="@android:color/black"
                    android:backgroundTint="@color/green"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    app:tint="@android:color/white"
                    android:clipToOutline="true"
                    android:contentDescription="Edit Foto" />
            </FrameLayout>

            <!-- Nama Menu -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxStrokeColor="@color/maroon_700"
                app:hintTextColor="@color/maroon_700">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNamaMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_regular"
                    android:hint="Nama Menu"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Harga -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxStrokeColor="@color/maroon_700"
                app:hintTextColor="@color/maroon_700">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHargaMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Harga"
                    android:fontFamily="@font/nunito_regular"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Deskripsi Singkat -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxStrokeColor="@color/maroon_700"
                app:hintTextColor="@color/maroon_700">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDeskripsiSingkat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Deskripsi Singkat"
                    android:fontFamily="@font/nunito_regular"
                    android:inputType="textMultiLine" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Deskripsi Panjang -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:boxStrokeColor="@color/maroon_700"
                app:hintTextColor="@color/maroon_700">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDeskripsiPanjang"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="top"
                    android:hint="Deskripsi Detail"
                    android:fontFamily="@font/nunito_regular"
                    android:inputType="textMultiLine" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tombol Simpan -->
            <Button
                android:id="@+id/btnSimpanMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/maroon_700"
                android:text="Simpan"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@android:color/white"
                android:padding="12dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
