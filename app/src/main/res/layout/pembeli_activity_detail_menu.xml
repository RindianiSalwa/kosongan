<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E4E4E4">

    <!-- App Bar -->
    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/maroon_700"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/backIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail Menu"
            android:fontFamily="@font/quicksand_bold"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginStart="16dp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ScrollView untuk konten -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_below="@id/appBar"
        android:layout_above="@id/buttonTambahKeranjang"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            card_view:cardCornerRadius="16dp"
            card_view:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Frame untuk gambar + progress bar -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <!-- Gambar Menu -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:id="@+id/imageViewMenu"
                            android:layout_width="match_parent"
                            android:layout_height="350dp"
                            android:adjustViewBounds="true"
                            android:scaleType="centerCrop"
                            android:background="@android:color/darker_gray"/>
                    </androidx.cardview.widget.CardView>




                    <ProgressBar
                        android:id="@+id/progressImageDetail"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/maroon_700"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/textViewNamaMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nama Menu"
                    android:fontFamily="@font/nunito_bold"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <TextView
                    android:id="@+id/textViewStok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stok: 0"
                    android:textSize="14sp"
                    android:fontFamily="@font/nunito_regular"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/textViewHarga"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp. 0"
                    android:textSize="14sp"
                    android:fontFamily="@font/nunito_regular"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/textViewDeskripsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#444"
                    android:textSize="16sp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="@font/nunito_regular"
                    android:text="Deskripsi menu..." />

                <TextView
                    android:id="@+id/textWarningStok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maaf, stoknya sedang habis"
                    android:fontFamily="@font/nunito_regular"
                    android:textColor="@android:color/holo_red_dark"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"
                    android:textSize="14sp"
                    android:gravity="center" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </ScrollView>

    <!-- Tombol fixed di bawah -->
    <Button
        android:id="@+id/buttonTambahKeranjang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Tambahkan ke Keranjang"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/maroon_700"
        android:padding="12dp"
        android:layout_margin="16dp" />

</RelativeLayout>
