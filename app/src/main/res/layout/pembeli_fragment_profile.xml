<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <!-- App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/red_coral"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:title="Profil"
        android:titleTextColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextAppearance="@style/PembeliToolbarTitle" />

    <!-- CardView Profile -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topAppBar">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Foto Profil Bulat -->
            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_centerHorizontal="true"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_profile" />

            <!-- Nama -->
            <TextView
                android:id="@+id/textViewNama"
                android:layout_below="@id/profileImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="Nama Pembeli"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginTop="12dp" />

            <!-- No HP -->
            <TextView
                android:id="@+id/textViewNoHP"
                android:layout_below="@id/textViewNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="081234567890"
                android:textSize="16sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/textViewEmail"
                android:layout_below="@id/textViewNoHP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="email@contoh.com"
                android:textSize="16sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="4dp" />

            <!-- Tombol Edit Profil -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditProfile"
                android:layout_below="@id/textViewEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Edit Profil"
                android:layout_marginTop="24dp"
                android:textColor="@color/white"
                android:backgroundTint="@color/red_coral"
                android:padding="12dp"
                app:cornerRadius="14dp"
                app:elevation="0dp" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
