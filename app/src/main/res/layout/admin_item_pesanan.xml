<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="12dp"
    app:cardMaxElevation="16dp"
    app:cardUseCompatPadding="true"
    android:backgroundTint="@color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Informasi Pembeli -->
        <TextView
            android:id="@+id/tvNamaPembeli"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Pembeli"
            android:fontFamily="@font/nunito_bold"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/tvNoHp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="08123456789"
            android:fontFamily="@font/nunito_bold"
            android:textSize="14sp"
            android:textColor="#616161"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvWaktu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waktu Pesan"
            android:fontFamily="@font/nunito_bold"
            android:textColor="#424242"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvWaktuUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update: -"
            android:fontFamily="@font/nunito_bold"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"
            android:visibility="gone"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvAlamat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alamat"
            android:fontFamily="@font/nunito_bold"
            android:textColor="#424242"
            android:layout_marginBottom="6dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="8dp"/>

        <!-- Daftar Menu (Horizontal RecyclerView) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDaftarMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <!-- Catatan -->
        <TextView
            android:id="@+id/tvCatatan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Catatan: Tanpa sambal"
            android:fontFamily="@font/nunito_bold"
            android:textColor="#757575"
            android:visibility="gone"
            android:layout_marginBottom="6dp"/>

        <!-- Total Harga -->
        <TextView
            android:id="@+id/tvTotalHarga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: Rp45.000"
            android:fontFamily="@font/nunito_bold"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/maroon_700"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvStatusPesanan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Selesai"
            android:fontFamily="@font/montserrat_bold"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#2E7D32"
            android:layout_marginTop="2dp"/>

        <!-- Tombol Pesan Lagi -->
        <Button
            android:id="@+id/buttonPesanLagi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pesan Lagi"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/montserrat_bold"
            android:backgroundTint="@color/maroon_700"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:visibility="gone"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"/>

        <!-- Tombol Aksi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnMasak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masak"
                android:fontFamily="@font/montserrat_bold"
                android:backgroundTint="@color/maroon_700"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
