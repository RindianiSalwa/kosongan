<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF6B00"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:text="Status Pesanan"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_margin="16dp">

        <TextView
            android:text="ID Pesanan"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvIdPesanan"
            android:text="-"
            android:textSize="13sp"
            android:textColor="#000000"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Status Saat Ini"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvStatus"
            android:text="MENUNGGU_APPROVAL"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FF6B00"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Alamat"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvAlamat"
            android:text="-"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginBottom="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Total"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvTotal"
            android:text="Rp 0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FF6B00"
            android:layout_marginBottom="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- TOMBOL TRACKING, muncul kalau status DIANTAR -->
        <Button
            android:id="@+id/btnTracking"
            android:text="Lihat Tracking Kurir"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF6B00"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="52dp"/>

    </LinearLayout>

</LinearLayout>