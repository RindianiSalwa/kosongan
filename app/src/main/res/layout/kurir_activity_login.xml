<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_page"
    android:overScrollMode="never"
    tools:context=".kurir.LoginKurirActivity">

  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:focusableInTouchMode="true"
        android:clickable="true">

      <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@color/red_coral">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="52dp"
            android:paddingBottom="40dp"
            android:paddingHorizontal="24dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="DAPUR ANDIA"
              android:textColor="#FFFFFF"
              android:textSize="10sp"
              android:letterSpacing="0.18"
              android:fontFamily="@font/montserrat_bold"
              android:paddingHorizontal="14dp"
              android:paddingVertical="5dp"
              android:background="@drawable/bg_badge_white"
              android:layout_marginBottom="20dp" />

          <com.airbnb.lottie.LottieAnimationView
              android:id="@+id/lottieLogin"
              android:layout_width="110dp"
              android:layout_height="110dp"
              app:lottie_rawRes="@raw/login"
              app:lottie_autoPlay="true"
              app:lottie_loop="true"
              android:background="@drawable/bg_lottie_white_ring"
              android:layout_marginBottom="18dp" />

          <TextView
              android:id="@+id/loginKurirText"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Login Kurir"
              android:fontFamily="serif"
              android:textStyle="bold"
              android:textColor="#FFFFFF"
              android:textSize="20sp"
              android:gravity="center"
              android:textAlignment="center"
              android:lineSpacingMultiplier="1.3"
              android:layout_marginBottom="14dp" />

          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center"
              android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aman"
                android:textSize="10sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/chip_green_text"
                android:background="@drawable/bg_chip_green"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terverifikasi"
                android:textSize="10sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/chip_blue_text"
                android:background="@drawable/bg_chip_blue"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kurir"
                android:textSize="10sp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/chip_orange_text"
                android:background="@drawable/bg_chip_orange"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp" />

          </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_back_button_white"
            android:contentDescription="Back"
            android:layout_margin="16dp"
            android:padding="8dp"
            android:layout_gravity="top|start" />

      </FrameLayout>

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:background="@color/bg_white"
          android:paddingHorizontal="22dp"
          android:paddingTop="28dp"
          android:paddingBottom="36dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KREDENSIAL KURIR"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="10dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/emailInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="Email"
            app:boxStrokeColor="@color/indigo_400"
            app:boxStrokeWidth="1.5dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxBackgroundColor="@color/field_bg"
            app:hintTextColor="@color/text_muted"
            app:startIconDrawable="@drawable/ic_email"
            app:startIconTint="@color/orange_icon">

          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/emailEditText"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="textEmailAddress"
              android:textSize="14sp"
              android:textColor="@color/text_dark"
              android:paddingVertical="14dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:hint="Password"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/text_muted"
            app:boxStrokeColor="@color/indigo_400"
            app:boxStrokeWidth="1.5dp"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxBackgroundColor="@color/field_bg"
            app:hintTextColor="@color/text_muted"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="@color/orange_icon">

          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/passwordEditText"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="textPassword"
              android:textSize="14sp"
              android:textColor="@color/text_dark"
              android:paddingVertical="14dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Masuk"
            android:textAllCaps="false"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            app:cornerRadius="14dp"
            android:backgroundTint="@color/red_coral"
            app:icon="@drawable/ic_login_arrow"
            app:iconTint="#FFFFFF"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:elevation="0dp"
            android:stateListAnimator="@null" />

      </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/maroon_600"
        android:layout_gravity="center" />

  </FrameLayout>

</androidx.core.widget.NestedScrollView>