<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="2dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- Checkbox -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkBoxPilih"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:buttonTint="@color/red_coral" />

        <!-- Gambar -->
        <androidx.cardview.widget.CardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/imageMenu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_menu"/>
        </androidx.cardview.widget.CardView>


        <!-- Info Menu -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Menu"
                android:ellipsize="end"
                android:textStyle="bold"
                android:fontFamily="@font/nunito_bold"
                android:maxLines="1"
                android:textColor="@color/text_dark"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textHarga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp. 13000"
                android:textColor="@color/red_coral"
                android:fontFamily="@font/nunito_bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textStokHabis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maaf, stoknya sedang habis"
                android:textColor="@color/red_coral_dark"
                android:fontFamily="@font/nunito_bold"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginTop="2dp" />

            <!-- Kontrol jumlah -->
            <LinearLayout
                android:id="@+id/layoutJumlah"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/buttonKurang"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="-"
                    android:textSize="16sp"
                    android:padding="0dp"
                    android:backgroundTint="@color/red_coral"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/textJumlah"
                    android:layout_width="40dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="1"
                    android:fontFamily="@font/nunito_bold"
                    android:textSize="14sp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/buttonTambah"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="+"
                    android:textSize="16sp"
                    android:padding="0dp"
                    android:backgroundTint="@color/red_coral"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tombol Hapus (di kanan) -->
        <ImageButton
            android:id="@+id/buttonHapus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Hapus menu"
            android:layout_marginStart="8dp"
            app:tint="@color/red_coral_dark" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
